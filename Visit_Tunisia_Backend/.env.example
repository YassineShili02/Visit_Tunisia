# Copier ce fichier vers .env puis remplir avec vos vraies valeurs
# cp .env.example .env

# Base de donnees PostgreSQL
DB_PASSWORD=votre_mot_de_passe_db

# Secret JWT (min 32 caracteres pour HMAC-SHA256)
JWT_SECRET=changez_moi_chaine_aleatoire_de_32_caracteres_minimum

# SMTP (Gmail : mot de passe d'application, pas le mot de passe du compte)
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=mot_de_passe_application_gmail_16_caracteres

# OpenWeatherMap
WEATHER_API_KEY=votre_cle_openweather
